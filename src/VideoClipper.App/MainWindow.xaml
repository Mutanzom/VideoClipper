<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VideoClipper.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VideoClipper.App"
    xmlns:vm="using:VideoClipper.App.ViewModels"
    Title="Video Clipper">

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" PointerPressed="Root_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Invisible focus target: see Root_PointerPressed. -->
        <ContentControl x:Name="FocusSink" Width="0" Height="0" IsTabStop="False" />

        <!-- ============================================================ title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock Text="Video Clipper" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============================================================ toolbar -->
        <Grid Grid.Row="1" Padding="16,4,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="Open_Click" IsEnabled="{x:Bind ViewModel.CanEditSettings, Mode=OneWay}" ToolTipService.ToolTip="Open a video (Ctrl+O)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                    <TextBlock Text="Open video" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FileName, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind ViewModel.VideoPath, Mode=OneWay}" />
        </Grid>

        <!-- ============================================================ main -->
        <Grid Grid.Row="2" Padding="16,0,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Player, timeline, transport -->
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="Black" CornerRadius="8">
                    <Grid>
                        <MediaPlayerElement x:Name="Player" Stretch="Uniform" AreTransportControlsEnabled="False"
                                            Tapped="Player_Tapped" />
                        <StackPanel Visibility="{x:Bind local:MainWindow.Hide(ViewModel.HasVideo), Mode=OneWay}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE714;" FontSize="48" Foreground="#99FFFFFF" />
                            <TextBlock Text="Drop a video here, or click Open video" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Timeline: clip ranges, pending start, playhead. Click or drag to seek. -->
                <Grid x:Name="Timeline" Grid.Row="1" Height="44" CornerRadius="6"
                      Background="{ThemeResource ControlFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                      SizeChanged="Timeline_SizeChanged"
                      PointerPressed="Timeline_PointerPressed" PointerMoved="Timeline_PointerMoved"
                      PointerReleased="Timeline_PointerReleased" PointerCaptureLost="Timeline_PointerCaptureLost">
                    <Canvas x:Name="TimelineCanvas" />
                </Grid>

                <!-- Transport + marking -->
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsHitTestVisible="{x:Bind ViewModel.HasVideo, Mode=OneWay}">
                        <Button Click="Back1s_Click" Content="−1s" ToolTipService.ToolTip="Back 1 second (Shift+Left)" />
                        <Button Click="BackFrame_Click" ToolTipService.ToolTip="Previous frame (Left)">
                            <FontIcon Glyph="&#xE76B;" FontSize="16" />
                        </Button>
                        <Button x:Name="PlayButton" Click="Play_Click" ToolTipService.ToolTip="Play / pause (Space)" Width="56">
                            <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                        </Button>
                        <Button Click="NextFrame_Click" ToolTipService.ToolTip="Next frame (Right)">
                            <FontIcon Glyph="&#xE76C;" FontSize="16" />
                        </Button>
                        <Button Click="Fwd1s_Click" Content="+1s" ToolTipService.ToolTip="Forward 1 second (Shift+Right)" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0">
                        <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="15" Margin="0,0,10,0" />
                        <FontIcon Glyph="&#xEC4A;" FontSize="16" Opacity="0.7" ToolTipService.ToolTip="Playback speed" />
                        <TextBox x:Name="ViewSpeedBox" Text="1" Width="64" MinWidth="0" FontFamily="Consolas" TextAlignment="Right"
                                 IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                                 ToolTipService.ToolTip="Playback speed for watching, e.g. 0.1, 0.25, 1.5 (type and press Enter). New clips get this speed; change it per clip in the list."
                                 LostFocus="ViewSpeed_LostFocus" KeyDown="ViewSpeed_KeyDown" />
                        <TextBlock Text="×" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Click="MarkStart_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                                ToolTipService.ToolTip="Start a clip at the playhead (E)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="[" FontWeight="Bold" />
                                <TextBlock Text="Mark start" />
                                <TextBlock Text="E" Opacity="0.6" />
                            </StackPanel>
                        </Button>
                        <Button Click="MarkEnd_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="End the clip at the playhead and add it to the list (R)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Mark end" />
                                <TextBlock Text="R" Opacity="0.7" />
                                <TextBlock Text="]" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.MarkHint, Mode=OneWay}" Opacity="0.75"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>

            <!-- Clip list -->
            <Grid Grid.Column="1" RowSpacing="8" CornerRadius="8" Padding="0,8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,4,12,0">
                    <TextBlock Text="Clips" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ClipCountText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7" />
                </Grid>

                <TextBlock Grid.Row="1" Margin="16,8" TextWrapping="Wrap" Opacity="0.7"
                           Visibility="{x:Bind local:MainWindow.Hide(ViewModel.HasClips), Mode=OneWay}"
                           Text="No clips yet. Move to where a clip begins and press Mark start (E), then move to where it ends and press Mark end (R). Repeat for more clips." />

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Clips}" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="Clips_ItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClipItem">
                            <Grid RowSpacing="6" ColumnSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" Opacity="0.7" FontFamily="Consolas" VerticalAlignment="Center"
                                               ToolTipService.ToolTip="{x:Bind DurationToolTip, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBox Tag="speed" Text="{x:Bind SpeedText, Mode=OneWay}" Width="58" MinWidth="0" FontFamily="Consolas" TextAlignment="Right"
                                                 ToolTipService.ToolTip="Export speed, e.g. 0.25 (slow motion) or 2 (twice as fast). Anything but 1 is re-encoded, even in Fast mode."
                                                 LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown" />
                                        <TextBlock Text="×" VerticalAlignment="Center" Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               ToolTipService.ToolTip="{x:Bind Message, Mode=OneWay}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="3" Click="RemoveClip_Click" Padding="6" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Remove clip">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>

                                <TextBox Grid.Row="1" Tag="start" Text="{x:Bind StartText, Mode=OneWay}" FontFamily="Consolas"
                                         ToolTipService.ToolTip="Start (edit and press Enter)"
                                         LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="→" VerticalAlignment="Center" Opacity="0.6" />
                                <TextBox Grid.Row="1" Grid.Column="2" Tag="end" Text="{x:Bind EndText, Mode=OneWay}" FontFamily="Consolas"
                                         ToolTipService.ToolTip="End (edit and press Enter)"
                                         LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown" />
                                <Button Grid.Row="1" Grid.Column="3" Click="PlayClip_Click" Padding="6" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Play this clip">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                </Button>

                                <ProgressBar Grid.Row="2" Grid.ColumnSpan="4" Value="{x:Bind Progress, Mode=OneWay}" Maximum="1"
                                             Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- ============================================================ export bar -->
        <Grid Grid.Row="3" Padding="16,12" ColumnSpacing="16"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsHitTestVisible="{x:Bind ViewModel.CanEditSettings, Mode=OneWay}">
                <RadioButton x:Name="FastMode" GroupName="Mode" Content="Fast (lossless)" Checked="Mode_Checked" MinWidth="0" Margin="0,0,12,0"
                             ToolTipService.ToolTip="Copies the video as-is: instant, no quality loss. The cut starts at the nearest keyframe, so a clip may begin slightly early." />
                <RadioButton x:Name="ReencodeMode" GroupName="Mode" Content="Re-encode" Checked="Mode_Checked" MinWidth="0"
                             ToolTipService.ToolTip="Encodes a new H.264 MP4: frame-exact cuts and smaller files, but slower." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox ItemsSource="{x:Bind vm:MainViewModel.QualityLabels}" SelectedIndex="{x:Bind ViewModel.QualityIndex, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.CanEditReencodeSettings, Mode=OneWay}" MinWidth="130"
                          ToolTipService.ToolTip="Re-encode quality (ignored when a size limit is set)" />
                <NumberBox Value="{x:Bind ViewModel.MaxSizeMb, Mode=TwoWay}" PlaceholderText="No size limit" Width="150"
                           Minimum="0.5" Maximum="100000" SmallChange="1" LargeChange="10"
                           SpinButtonPlacementMode="Compact" IsEnabled="{x:Bind ViewModel.CanEditReencodeSettings, Mode=OneWay}"
                           ToolTipService.ToolTip="Max size per clip in MB, e.g. 10 for Discord. Leave empty for no limit." />
                <TextBlock Text="MB" VerticalAlignment="Center" Opacity="0.7" />
                <CheckBox Content="Mute audio" IsChecked="{x:Bind ViewModel.Mute, Mode=TwoWay}" MinWidth="0" Margin="12,0,0,0"
                          IsEnabled="{x:Bind ViewModel.CanEditSettings, Mode=OneWay}"
                          ToolTipService.ToolTip="Export the clips without sound (works in both modes)" />
            </StackPanel>

            <!-- A Grid, not a StackPanel, so the path is the part that shrinks when the window is narrow. -->
            <Grid Grid.Column="2" ColumnSpacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="16" Opacity="0.7" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OutputFolderText, Mode=OneWay}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.OutputFolder, Mode=OneWay}" Opacity="0.85" />
                <Button Grid.Column="2" Content="Change…" Click="ChangeFolder_Click" IsEnabled="{x:Bind ViewModel.CanEditSettings, Mode=OneWay}" />
            </Grid>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Click="Cancel_Click" Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay}" />
                <Button Click="Export_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}" MinWidth="140">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDE1;" FontSize="16" />
                        <TextBlock Text="Export all" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--
            Notices float over the top of the video instead of taking a layout row, so showing one
            never resizes the player. Declared last so it draws above everything; centered on the
            video column (right margin = clip list width + gaps).
        -->
        <Border Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="32,16,404,0" MaxWidth="760"
                CornerRadius="8" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                Visibility="{x:Bind Notice.IsOpen, Mode=OneWay}" Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <InfoBar x:Name="Notice" IsOpen="False" />
        </Border>
    </Grid>
</Window>
